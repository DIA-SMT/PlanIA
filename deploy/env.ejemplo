# Variables de PlanIA en producción. Plantilla SIN valores: el archivo real es
# /srv/plania/compartido/.env (dueño plania, modo 600) y se completa a mano con
# nano en el servidor. Nunca commitear valores ni pegarlos en un chat.

NODE_ENV="production"

# --- Supabase (el mismo proyecto que usa Vercel hoy) ---
# Las NEXT_PUBLIC_* se graban en la compilación: si cambian, hay que redesplegar.
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""
# Con el Supabase de la propia VPS (deploy/migrar-base): la entrada interna del
# gateway, para la API admin, que el sitio público bloquea. Sin Supabase local,
# dejarla vacía.
SUPABASE_URL_INTERNA=""

# --- Chatbot (OpenRouter) ---
OPENROUTER_API_KEY=""

# --- Dirección pública de PlanIA (links en los correos), con https y sin barra final ---
PLANIA_URL="https://plania.195-35-42-168.sslip.io"

# --- Corte trimestral (lo llama GitHub Actions) ---
# Generarlo en el servidor:  openssl rand -base64 48
# El mismo valor va en el secret CORTE_TRIMESTRAL_SECRET del repo en GitHub.
CORTE_TRIMESTRAL_SECRET=""

# --- Correo: SMTP o Resend (copiar lo que hoy tenga Vercel) ---
# Las que no se usen van COMENTADAS, no vacías: el código hace
# `SMTP_HOST ?? "smtp.gmail.com"` y un "" anula ese valor por defecto
# (lo mismo SMTP_PUERTO, que vacío da 0).
SMTP_USUARIO=""
SMTP_PASSWORD=""
CORREO_REMITENTE=""
# SMTP_HOST=""          # por defecto smtp.gmail.com
# SMTP_PUERTO=""        # por defecto 465
# RESEND_API_KEY=""
# CORREO_RESPONDER_A=""
